POSTGRES_USER=villagebank
POSTGRES_PASSWORD=change_me
POSTGRES_DB=villagebank

Jwt__SigningKey=
Seed__SuperAdmin__Username=
Seed__SuperAdmin__Password=

# Demo data, created only by the seed-demo command (see README). It never runs on its own.
# The password is shared by the demo users manager01, teller01 and auditor01.
Seed__Demo__Password=

# Set to false in production: Swagger lets anyone read the API description.
Swagger__Enabled=true

# Origin of the web front end that is allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:3000
